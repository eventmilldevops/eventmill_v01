      "_fallback_note": "GA endpoint; no fallback needed. Verified live 2026-09-12 against models.get: id exists, display_name 'Gemini 3.8 Flash', 1048576 in / 65536 out, thinking_level honoured, native PDF read. EVENTMILL_MODEL_LIGHT overrides model_id, EVENTMILL_MAX_OUTPUT_LIGHT the cap, without a code change."
    },
    "heavy": {
      "model_id": "gemini-3.1-pro-preview",
      "display_name": "Gemini 3.1 Pro",
      "fallback_model_id": "gemini-3.5-flash",
      "_fallback_note": "model_id is a Preview endpoint; Google gives ~2 weeks notice before preview deprecation. EVENTMILL_MODEL_HEAVY overrides model_id without a code change.",
      "api_key_env": "GEMINI_PRO_API_KEY",
      "max_output_tokens": 65536,
      "max_context_tokens": 1048576,
      "cost_tier": "high",
      "capabilities": [
        "text",
        "multimodal_image",
        "native_pdf",
        "structured_output",
        "function_calling",
        "deep_reasoning"
      ]
