# Event Mill Configuration
# Copy this file to .env and fill in your values:  cp .env.example .env
#
# .env is gitignored and is read at startup by `python -m framework.cli.shell`
# running locally. It is NOT read on Cloud Run — there these variables arrive
# from Secret Manager via the deploy script's --set-secrets, and a stray file
# must not shadow them. Nothing here can override a variable that is already
# set in the environment, on either path. Neither Dockerfile copies the repo
# root, so .env cannot reach a container image.

# =============================================================================
# MCP Configuration
# =============================================================================

# MCP transport type: stdio or sse
EVENTMILL_MCP_TRANSPORT=stdio

# Model provider endpoint (provider-specific)
EVENTMILL_MCP_ENDPOINT=

# Model tiers — plugins declare model_tier in their manifest.json.
# Defaults come from framework/llm/providers/gcp_gemini.json; set these only
# to point a tier at a different model id.
# Heavy: deep reasoning tasks (threat modeling, attack paths, risk assessment)
EVENTMILL_MODEL_HEAVY=gemini-3.1-pro-preview
# Light: bulk operations (log reading, pattern scanning, report ingestion)
EVENTMILL_MODEL_LIGHT=gemini-3.5-flash

# =============================================================================
# Google Cloud Platform (optional, for GCP deployment)
# =============================================================================

# Path to service account key file
GOOGLE_APPLICATION_CREDENTIALS=

# GCS bucket for artifact storage (single-bucket legacy mode)
GCS_ARTIFACT_BUCKET=

# Bucket prefix for pillar-based storage (recommended)
# Buckets created: {prefix}-log-analysis, {prefix}-network-forensics,
#                  {prefix}-threat-modeling, {prefix}-common
# Convention: {project_id}-eventmill
EVENTMILL_BUCKET_PREFIX=

# GCP project ID
GCP_PROJECT_ID=

# GCP region
GCP_REGION=us-central1

# =============================================================================
# API Keys (provider-specific)
# =============================================================================

# Gemini API keys — one per model tier to isolate quota and billing
# Get keys from: https://aistudio.google.com/apikey
# Using separate keys prevents high-volume Flash calls from affecting Pro quota
#
# >>> PUT YOUR KEY VALUES ON THE TWO LINES BELOW <<<
#
# If the keys are already in Secret Manager (they are, if you have deployed),
# read them out rather than retyping — the secret names are the ones
# deploy-cloudrun-secrets.sh feeds to --set-secrets:
#
#   gcloud secrets versions access latest --secret=eventmill-gemini-flash-api
#   gcloud secrets versions access latest --secret=eventmill-gemini-pro-api
#
# Paste after the `=` with no quotes and no trailing whitespace. A stray
# newline or quote character produces an auth failure that reads like an
# invalid key. Both are optional — leave one blank and that tier is simply
# unavailable. `models` in the shell shows which keys resolved.
#
# heavy/Pro is the one that matters for threat_intel_ingester,
# threat_report_analyzer, threat_model_analyzer, and adversary_path_projector
# path projection.
GEMINI_FLASH_API_KEY=
GEMINI_PRO_API_KEY=

# One key per provider — neither vendor splits keys by tier, unlike the two
# Gemini keys above, which exist so bulk Flash work cannot consume Pro quota.
# Anthropic API key — claude-sonnet-5 (light) / claude-opus-5 (heavy)
ANTHROPIC_API_KEY=

# OpenAI API key — gpt-5.6-terra (light) / gpt-5.6-sol (heavy)
OPENAI_API_KEY=

# OpenAI Daybreak API key — a SEPARATE credential from OPENAI_API_KEY, read by
# both openai_daybreak_red and openai_daybreak_blue. One key, two providers,
# because it is one credential reaching two models. Each declares that model
# under both tiers, so a light-tier and a heavy-tier plugin reach it alike.
# Leave unset unless you have been provisioned for these models; the other
# providers are unaffected by its absence.
OPENAI_DAYBREAK_API_KEY=

# Providers this session may bind, space-separated.
# Known ids: gcp_gemini anthropic openai openai_daybreak_red
# openai_daybreak_blue. An unknown id is refused rather than ignored — a typo
# would otherwise look like a working session until a tool tried to use that
# provider.
#
# Provider is not the same thing as vendor: the three openai* ids are one
# vendor reaching three different models on two different keys. 'providers'
# shows both.
#
# Setting a key does NOT bind its provider: this variable is what does, which
# is why all of them are named by default. A provider whose key is unset or still
# holds "placeholder" is skipped at startup and reported, so naming one costs
# nothing — while leaving one out means a vendor you have a real key for never
# binds, and the symptom is a vendor that is simply missing rather than an error.
#
# 'providers' shows what is configured and keyed; 'providers probe <id>' proves
# a key actually reaches its vendor and works even on a provider not named
# here, so a key can be verified before it is adopted.
EVENTMILL_LLM_PROVIDERS=gcp_gemini anthropic openai openai_daybreak_red openai_daybreak_blue

# =============================================================================
# Runtime Configuration
# =============================================================================

# Workspace directory for sessions, artifacts, logs
EVENTMILL_WORKSPACE=./workspace

# Log level: INFO or DEBUG
EVENTMILL_LOG_LEVEL=INFO

# Native-document latency model for threat_intel_ingester's page-range
# batching (seconds per unit). Unset uses the plugin's own values
# (10 base, 12 per page, 0.7 per candidate). This decides how a large PDF is
# SPLIT, not how long a run may take: the shipped per-page figure overestimates
# a 154-page report by ~6x, so it splits into far more calls than needed and
# separates pages that should be read together. Check the "[PLAN] ... est. Ns"
# log line against the run's real duration before changing these.
# EVENTMILL_NATIVE_BASE_S=10
# EVENTMILL_NATIVE_S_PER_PAGE=0.3
# EVENTMILL_NATIVE_S_PER_CANDIDATE=0.7

# Reasoning depth for adversary_path_projector's path projection:
#   minimal | low | medium | high        (plugin default: medium)
#
# This is the knob that decides whether the projection reasons deeply about how
# an actor would move through your architecture, or answers quickly. It is the
# value of the LLM step over re-summarising ATT&CK, so raise it where latency
# allows: "high" roughly quadrupled call time on a 7-component map (27s -> 110s+,
# far enough to hit the provider's gateway deadline), so it suits Cloud Run
# better than an interactive session.
#
# Precedence: --thinking_level on the call > this variable > the plugin default.
# EVENTMILL_PROJECTION_THINKING=high

# =============================================================================
# ttyd Web Terminal (Cloud Run deployment only)
# =============================================================================

# Username and password for the browser-based terminal login
# Change these from defaults before deploying
TTYD_USERNAME=analyst
TTYD_PASSWORD=changeme

# Maximum tools to expose per routing decision
EVENTMILL_MAX_CANDIDATE_TOOLS=5

# Default expansion mode: strict or adjacent
EVENTMILL_EXPANSION_MODE=strict
